<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Insurance_For_Approval</fullName>
    <active>true</active>
    <description>Approved vendors must have current insurance on file.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Approved&quot;),
    OR(ISBLANK(Insurance_Expiry_Date__c), Insurance_Expiry_Date__c &lt;= TODAY())
)</errorConditionFormula>
    <errorDisplayField>Insurance_Expiry_Date__c</errorDisplayField>
    <errorMessage>Enter an insurance expiry date in the future before approving this vendor.</errorMessage>
</ValidationRule>
