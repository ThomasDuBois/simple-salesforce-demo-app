<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Check_Duplicates</name>
        <label>Check for Duplicate Requests</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>VendorDuplicateChecker</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Has_Duplicates</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>vendorName</name>
            <value>
                <elementReference>Vendor_Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>contactEmail</name>
            <value>
                <elementReference>Vendor_Contact_Email</elementReference>
            </value>
        </inputParameters>
        <nameSegment>VendorDuplicateChecker</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <choices>
        <name>Cancel_Choice</name>
        <choiceText>No, cancel - I&apos;ll follow up on the existing request</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>cancel</stringValue>
        </value>
    </choices>
    <choices>
        <name>Continue_Choice</name>
        <choiceText>Yes, continue - this is a different vendor or a new engagement</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>continue</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Continue_Anyway</name>
        <label>Continue Anyway?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>Continue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Duplicate_Decision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Continue_Choice</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Request</targetReference>
            </connector>
            <label>Continue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Duplicates</name>
        <label>Has Duplicates?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Duplicates</defaultConnectorLabel>
        <rules>
            <name>Duplicates_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Duplicates.hasDuplicates</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Duplicate_Warning</targetReference>
            </connector>
            <label>Duplicates Found</label>
        </rules>
    </decisions>
    <description>Guided intake for a new vendor onboarding request. Replaces the &quot;email procurement&quot; step of the old spreadsheet process. Warns about duplicate requests, then creates a Vendor Onboarding record in Submitted status with the running user as Requester.</description>
    <dynamicChoiceSets>
        <name>Category_Choices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
        <object xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
        <picklistField>Category__c</picklistField>
        <picklistObject>Vendor_Onboarding__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>New Vendor Request {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>New Vendor Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Request</name>
        <label>Create Vendor Onboarding Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Confirmation</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Business_Justification__c</field>
            <value>
                <elementReference>Business_Justification</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Category__c</field>
            <value>
                <elementReference>Category</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Estimated_Annual_Spend__c</field>
            <value>
                <elementReference>Estimated_Annual_Spend</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Requester__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Vendor_Contact_Email__c</field>
            <value>
                <elementReference>Vendor_Contact_Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Vendor_Name__c</field>
            <value>
                <elementReference>Vendor_Name</elementReference>
            </value>
        </inputAssignments>
        <object>Vendor_Onboarding__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Cancelled</name>
        <label>Cancelled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Cancelled_Message</name>
            <fieldText>&lt;p&gt;No request was created. Contact procurement about the existing request listed on the previous screen.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Confirmation</name>
        <label>Request Submitted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Message</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Thanks!&lt;/b&gt; Your request for &lt;b&gt;{!Vendor_Name}&lt;/b&gt; has been submitted to procurement.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;/lightning/r/Vendor_Onboarding__c/{!Create_Request}/view&quot; target=&quot;_self&quot;&gt;View your request&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Duplicate_Warning</name>
        <label>Possible Duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Continue_Anyway</targetReference>
        </connector>
        <fields>
            <name>Duplicate_Message</name>
            <fieldText>&lt;p&gt;We found {!Check_Duplicates.duplicateCount} existing request(s) that may be for the same vendor:&lt;/p&gt;&lt;p&gt;&lt;b&gt;{!Check_Duplicates.summary}&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Duplicate_Decision</name>
            <choiceReferences>Continue_Choice</choiceReferences>
            <choiceReferences>Cancel_Choice</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Submit a new request anyway?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText>&lt;p&gt;&lt;b&gt;The request couldn&apos;t be saved.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Request_Details</name>
        <label>New Vendor Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Check_Duplicates</targetReference>
        </connector>
        <fields>
            <name>Intro</name>
            <fieldText>&lt;p&gt;Tell procurement about the vendor you&apos;d like to use. They&apos;ll collect the W-9 and insurance certificate from the vendor and route the request to Finance.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Vendor_Name</name>
            <dataType>String</dataType>
            <fieldText>Vendor Name</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Vendor_Contact_Email</name>
            <dataType>String</dataType>
            <fieldText>Vendor Contact Email</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Who procurement should contact for documents.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;Enter a valid email address.&lt;/p&gt;</errorMessage>
                <formulaExpression>OR(ISBLANK({!Vendor_Contact_Email}), REGEX({!Vendor_Contact_Email}, &quot;[^@\\s]+@[^@\\s]+\\.[^@\\s]+&quot;))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Category</name>
            <choiceReferences>Category_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Category</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Estimated_Annual_Spend</name>
            <dataType>Currency</dataType>
            <fieldText>Estimated Annual Spend</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <validationRule>
                <errorMessage>&lt;p&gt;Spend can&apos;t be negative.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Estimated_Annual_Spend} &gt;= 0</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Business_Justification</name>
            <fieldText>Business Justification</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Request_Details</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
